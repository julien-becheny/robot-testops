{
  "name": "testops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "framer-motion": "^10.16.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "socket.io-client": "^4.8.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint src vite.config.js eslint.config.js --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"../.github/workflows/*.{yml,yaml}\" vite.config.js eslint.config.js index.html package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"../.github/workflows/*.{yml,yaml}\" vite.config.js eslint.config.js index.html package.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "5.1.4",
    "confusing-browser-globals": "1.0.11",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.6",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
